# Copy to .env and fill in real values:
#   cp .env.example .env

SERVER_PORT=8080

# PostgreSQL (Supabase — prefer Session pooler for cloud hosts / IPv4)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=

# Email (Gmail SMTP app password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# CORS / frontend
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ezfinanz.vercel.app
APP_FRONTEND_URL=http://localhost:5173

# JWT (use a long random string in production)
APP_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
APP_JWT_EXPIRATION_MS=86400000

# Seeded super admin
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_ADMIN_FULL_NAME=EZFINANZ Admin
APP_SUPPORT_NOTIFY_EMAIL=

# OpenAI (RAG chatbot)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=ezfinanz-support

# Google OAuth
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# OTP
APP_OTP_TTL_MINUTES=10

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ezfinanz-files

SHOW_SQL=false
